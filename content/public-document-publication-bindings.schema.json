{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/public-document-publication-bindings.schema.json",
  "title": "SSKEMS public document publication bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "registryId", "publicBasePath", "policy", "bindings"],
  "properties": {
    "$schema": { "const": "./public-document-publication-bindings.schema.json" },
    "schemaVersion": { "const": 1 },
    "registryId": { "const": "sskem-public-document-publication-bindings" },
    "publicBasePath": { "const": "/documents/production" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedManifestRequired", "exactStagedReceiptHashRequired", "exactPublicPdfHashRequired", "externalMalwareEvidenceRequired", "privateEvidenceStoredInRepository", "notes"],
      "properties": {
        "approvedManifestRequired": { "const": true },
        "exactStagedReceiptHashRequired": { "const": true },
        "exactPublicPdfHashRequired": { "const": true },
        "externalMalwareEvidenceRequired": { "const": true },
        "privateEvidenceStoredInRepository": { "const": false },
        "notes": { "type": "string", "minLength": 20 }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status", "academicYear", "publicationYear", "issuingAuthority", "issueDate", "expiryDate", "language", "publicNote"],
      "properties": {
        "label": { "type": "string", "minLength": 3, "maxLength": 100 },
        "status": { "enum": ["current", "expiring-soon"] },
        "academicYear": { "type": ["string", "null"], "pattern": "^20[0-9]{2}(?:[-–]20[0-9]{2})?$" },
        "publicationYear": { "type": ["string", "null"], "pattern": "^20[0-9]{2}$" },
        "issuingAuthority": { "type": "string", "minLength": 3, "maxLength": 160 },
        "issueDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": ["string", "null"], "format": "date" },
        "language": { "enum": ["English", "Marathi", "English and Marathi"] },
        "publicNote": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "recordId", "documentId", "publicFilename", "sourceSha256", "stagedReceiptSha256", "bytes", "pages", "accessibilityStatus", "publishedOn", "metadata", "notes"],
      "properties": {
        "bindingId": { "type": "string", "pattern": "^public-document-mpd-[bc]-[1-8]-[a-f0-9]{12}$" },
        "recordId": { "enum": ["document-mpd-b-1", "document-mpd-b-2", "document-mpd-b-3", "document-mpd-b-4", "document-mpd-b-5", "document-mpd-b-6", "document-mpd-b-7", "document-mpd-b-8", "document-mpd-c-1", "document-mpd-c-2", "document-mpd-c-3", "document-mpd-c-4"] },
        "documentId": { "enum": ["mpd-b-1", "mpd-b-2", "mpd-b-3", "mpd-b-4", "mpd-b-5", "mpd-b-6", "mpd-b-7", "mpd-b-8", "mpd-c-1", "mpd-c-2", "mpd-c-3", "mpd-c-4"] },
        "publicFilename": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$" },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stagedReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 25000000 },
        "pages": { "type": "integer", "minimum": 1, "maximum": 300 },
        "accessibilityStatus": { "enum": ["Tagged and accessible", "Text-readable"] },
        "publishedOn": { "type": "string", "format": "date-time" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "notes": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    }
  }
}
