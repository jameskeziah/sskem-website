{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/programmes-public-profiles.schema.json",
  "title": "SSKEMS verified programme public profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profileSetId", "approvalReference", "publishedOn", "profiles"],
  "properties": {
    "$schema": { "const": "./programmes-public-profiles.schema.json" },
    "schemaVersion": { "const": 1 },
    "profileSetId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "approvalReference": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,79}$" },
    "publishedOn": { "type": "string", "format": "date" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 12 },
        "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalPath"],
      "properties": {
        "title": { "type": "string", "minLength": 10, "maxLength": 70 },
        "description": { "type": "string", "minLength": 50, "maxLength": 170 },
        "canonicalPath": { "enum": ["/school/academics", "/junior-college", "/programmes/jee-neet"] }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "organisationId", "organisationType", "displayName", "navigationLabel", "eyebrow", "title", "summary", "publicationNote", "facts", "groups", "withheldSections", "evidenceReferences", "claimRecordIds", "seo", "validUntil"],
      "properties": {
        "id": { "enum": ["cbse-school", "junior-college", "neet-institute"] },
        "route": { "enum": ["/school/academics", "/junior-college", "/programmes/jee-neet"] },
        "organisationId": { "type": "string", "pattern": "^ORG-[A-Z0-9-]+$" },
        "organisationType": { "enum": ["cbse-school", "junior-college", "institute"] },
        "displayName": { "type": "string", "minLength": 3 },
        "navigationLabel": { "type": "string", "minLength": 3, "maxLength": 30 },
        "eyebrow": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 10 },
        "summary": { "type": "string", "minLength": 40 },
        "publicationNote": { "type": "string", "minLength": 40 },
        "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "withheldSections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "evidenceReferences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,79}$" } },
        "claimRecordIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" } },
        "seo": { "$ref": "#/$defs/seo" },
        "validUntil": { "type": ["string", "null"], "format": "date" }
      }
    }
  }
}
