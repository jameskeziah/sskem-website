{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/approval-manifest.schema.json",
  "title": "SSKEMS publication approval manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "manifestId", "updatedOn", "evidencePolicy", "checkProfiles", "records"],
  "properties": {
    "$schema": { "const": "./approval-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "manifestId": { "const": "sskem-publication-approvals" },
    "updatedOn": { "type": "string", "format": "date" },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateEvidenceStoredInRepository", "referencePattern", "notes"],
      "properties": {
        "privateEvidenceStoredInRepository": { "const": false },
        "referencePattern": { "type": "string" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "checkProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "checkState": {
      "enum": ["pending", "verified", "not-applicable", "failed", "withdrawn"]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "title", "sourcePointer", "publicTargets", "checkProfile",
        "checks", "decision", "evidenceReferences", "approvedByRole", "approvedAt",
        "expiresAt", "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(media|claim|document)-[a-z0-9-]+$" },
        "kind": { "enum": ["media", "claim", "document"] },
        "title": { "type": "string", "minLength": 3 },
        "sourcePointer": { "type": "string", "minLength": 3 },
        "publicTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "checkProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/checkState" }
        },
        "decision": { "enum": ["blocked", "review-required", "approved", "withdrawn"] },
        "evidenceReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,79}$",
            "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|file:|https?://|\\\\\\\\)|(?:^|/)\\.\\.?($|/)" }
          }
        },
        "approvedByRole": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date" },
        "notes": { "type": "string", "minLength": 3 }
      }
    }
  }
}
