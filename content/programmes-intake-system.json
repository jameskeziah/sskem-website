      {
        "id": "EXAM-PREPARATION",
        "title": "JEE, NEET and CET preparation",
        "fields": [
          { "id": "examPreparation.operator", "label": "Operator", "type": "multiple-choice", "required": true, "options": ["not-offered", "cbse-school", "junior-college", "separate-institute", "external-partner"] },
          { "id": "examPreparation.operatorName", "label": "Official operator name", "type": "short-text", "requiredWhen": "operator is separate-institute or external-partner or junior-college" },
          { "id": "examPreparation.programmes", "label": "Examinations or programmes", "type": "paragraph-list", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.studentGroups", "label": "Student groups", "type": "paragraph-list", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.durationSummary", "label": "Programme duration", "type": "short-text", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.deliveryMode", "label": "General delivery mode", "type": "dropdown", "requiredWhen": "operator is not not-offered", "options": ["on-campus", "hybrid", "online", "not-confirmed"] },
          { "id": "examPreparation.curriculum", "label": "Curriculum summary", "type": "paragraph", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.timetable", "label": "Timetable summary", "type": "paragraph", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.facultySummary", "label": "Approved public faculty summary", "type": "paragraph", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.feeSummary", "label": "Approved public fee summary", "type": "paragraph", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.facilitiesSummary", "label": "Facilities summary", "type": "paragraph", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.resultsPublication", "label": "Results-publication decision", "type": "multiple-choice", "requiredWhen": "operator is not not-offered", "options": ["no-results-published", "verified-results-approved"] },
          { "id": "examPreparation.verifiedResultsSummary", "label": "Verified aggregate results summary", "type": "paragraph", "requiredWhen": "resultsPublication is verified-results-approved" },
          { "id": "examPreparation.admissionsWindowState", "label": "Admissions window", "type": "dropdown", "requiredWhen": "operator is not not-offered", "options": ["dated", "year-round", "not-confirmed"] },
          { "id": "examPreparation.admissionsOpenOn", "label": "Admissions open on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "examPreparation.admissionsCloseOn", "label": "Admissions close on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "examPreparation.admissionsDecisionBy", "label": "Admissions decision by", "type": "date", "required": false },
          { "id": "examPreparation.batchCount", "label": "Current batch count", "type": "number", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.intakeCapacity", "label": "Current intake capacity", "type": "number", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.admissionsCtaLabel", "label": "Approved admissions CTA label", "type": "short-text", "requiredWhen": "operator is not not-offered" },
          { "id": "examPreparation.admissionsCtaDestination", "label": "Admissions CTA destination", "type": "short-text", "requiredWhen": "operator is not not-offered", "validation": "safe internal path or HTTPS URL" },
          { "id": "examPreparation.publicContactRoute", "label": "Public contact route", "type": "short-text", "requiredWhen": "operator is not not-offered", "validation": "safe internal route; no personal phone or email" },
          { "id": "examPreparation.publicSummary", "label": "Approved public summary", "type": "paragraph", "required": true },
          { "id": "examPreparation.factState", "label": "Exam-preparation facts confirmed?", "type": "multiple-choice", "required": true, "options": ["confirmed", "not-confirmed"] }
