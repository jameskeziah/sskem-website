{
  "schemaVersion": 2,
  "contractVersion": "1.1.0-draft",
  "intakeId": "sskem-programmes-intake-system",
  "purpose": "Collect and track management-reviewed programme information before it enters the guarded Programmes content package.",
  "authoritativeBoundaries": {
    "approvalManifest": "content/approval-manifest.json",
    "programmesPackageSchema": "content/programmes-content-package.schema.json",
    "programmesPublicationContractDraft": "content/programmes-publication-v1.1-draft.schema.json",
    "programmesReviewWorkspace": "/publication-review/programmes-content-package",
    "programmesWorkbookIntakeWorkspace": "/publication-review/programmes-workbook-intake",
    "programmesWorkbookIntakeReceipt": "content/programmes-workbook-intake-receipt.json",
    "completedWorkbookLocation": "controlled-google-drive-only",
    "repositoryContent": "public-safe-specification-and-opaque-references-only",
    "sanityContent": "approved-public-display-content-only"
  },
  "identifiers": {
    "programmes": [
      { "id": "PRG-CBSE-SS", "publicationId": "school-academics", "route": "/school/academics", "label": "CBSE Senior Secondary" },
      { "id": "PRG-JUNIOR-COLLEGE", "publicationId": "junior-college", "route": "/junior-college", "label": "Separate Junior College" },
      { "id": "PRG-EXAM-PREP", "publicationId": "jee-neet", "route": "/programmes/jee-neet", "label": "JEE, NEET and CET preparation" }
    ],
    "campusIdPattern": "^CMP-[A-Z0-9-]{2,40}$",
    "facultyIdPattern": "^FAC-[A-Z0-9-]{2,40}$",
    "feeIdPattern": "^FEE-20[0-9]{2}-20[0-9]{2}-[A-Z0-9-]{2,40}$",
    "resultIdPattern": "^RES-20[0-9]{2}-20[0-9]{2}-[A-Z0-9-]{2,40}$",
    "scholarshipIdPattern": "^SCH-20[0-9]{2}-20[0-9]{2}-[A-Z0-9-]{2,40}$",
    "evidenceIdPattern": "^EVD-20[0-9]{2}-[0-9]{3,4}$",
    "publicationItemIdPattern": "^PUB-[A-Z0-9-]{3,60}$",
    "documentReferenceIdPattern": "^DOCREF-[A-Z0-9-]{2,72}$",
    "admissionsActionIdPattern": "^CTA-[A-Z0-9-]{2,75}$",
    "relationshipIdPattern": "^REL-[A-Z0-9-]{2,75}$",
    "institutionalStatusIdPattern": "^STATUS-[A-Z0-9-]{2,72}$",
    "campusAvailabilityIdPattern": "^CAMPUS-AVAIL-[A-Z0-9-]{2,66}$"
  },
  "googleForm": {
    "title": "SSKEMS Programmes management intake",
    "responsePolicy": "One response per academic-year decision package. Restricted to authorised school roles.",
    "sections": [
      {
        "id": "FORM-CONTROL",
        "title": "Control record",
        "fields": [
          { "id": "academicYear", "label": "Academic year", "type": "short-text", "required": true, "validation": "consecutive YYYY-YYYY; normalize abbreviated 2026-27 only after reviewer confirmation" },
          { "id": "shortDisplayName", "label": "Short display name", "type": "short-text", "required": true },
          { "id": "programmeCategories", "label": "Selected programme categories", "type": "checkboxes", "required": true, "options": ["school", "foundation", "junior-college", "jee", "neet", "integrated", "hi-tech-lab"], "validation": "select actual categories; do not paste the option list" },
          { "id": "programmeStatuses", "label": "Current programme status", "type": "checkboxes", "required": true, "options": ["active", "admissions-open", "inactive", "not-confirmed"] },
          { "id": "requestedWebsitePublicationState", "label": "Requested website publication state", "type": "multiple-choice", "required": true, "options": ["do-not-publish", "request-publication-review"], "validation": "a request never grants publication authority" },
          { "id": "submissionRole", "label": "Submitting role", "type": "dropdown", "required": true, "validation": "role only; no name or email in exported package" },
          { "id": "institutionalModel", "label": "Current institutional model", "type": "multiple-choice", "required": true, "options": ["cbse-senior-secondary-only", "separate-junior-college-only", "both", "neither-current", "not-confirmed"] }
        ]
      },
      {
        "id": "OWNERSHIP-GOVERNANCE",
        "title": "Ownership and governance",
        "fields": [
          { "id": "ownership.officialOperatorOrganisationId", "label": "Organisation that officially operates the programme", "type": "short-text", "required": true, "validation": "stable ORG-* ID backed by the Organisations tab" },
          { "id": "ownership.enrolmentOrganisationId", "label": "Organisation under which students are officially enrolled", "type": "short-text", "required": true, "validation": "stable ORG-* ID; yes/no is invalid" },
          { "id": "ownership.feeCollectionOrganisationId", "label": "Organisation that collects fees", "type": "short-text", "required": true, "validation": "stable ORG-* ID" },
          { "id": "ownership.academicDeliveryOrganisationId", "label": "Organisation responsible for academic delivery", "type": "short-text", "required": true, "validation": "stable ORG-* ID" },
          { "id": "ownership.entranceExamCoachingOrganisationId", "label": "Organisation responsible for entrance-exam coaching", "type": "short-text", "required": true, "validation": "stable ORG-* ID or NOT CONFIRMED" },
          { "id": "ownership.certificationEntityOrganisationId", "label": "Certification or awarding entity", "type": "short-text", "required": false, "validation": "stable ORG-* ID or not-applicable; verify against the board record" },
          { "id": "ownership.governanceEvidenceIds", "label": "Governance responsibility evidence IDs", "type": "paragraph-list", "required": true, "validation": "opaque IDs only" },
          { "id": "ownership.factState", "label": "Ownership facts confirmed?", "type": "multiple-choice", "required": true, "options": ["confirmed", "not-confirmed"] }
        ]
      },
      {
        "id": "INSTITUTIONAL-RELATIONSHIP",
        "title": "Organisation relationship and wording",
        "fields": [
          { "id": "organisationRelationship.fromOrganisationId", "label": "Primary organisation ID", "type": "short-text", "required": true, "validation": "stable ORG-* ID" },
          { "id": "organisationRelationship.toOrganisationId", "label": "Related organisation ID", "type": "short-text", "required": true, "validation": "stable ORG-* ID distinct from the primary organisation" },
          { "id": "organisationRelationship.programmeIds", "label": "Programmes in relationship scope", "type": "checkboxes", "required": true },
          { "id": "organisationRelationship.relationshipType", "label": "Relationship type", "type": "dropdown", "required": true, "options": ["no-current-relationship", "operated-by", "delivered-by", "academic-partner", "part-of", "separate-institution", "not-confirmed"] },
          { "id": "organisationRelationship.approvedPublicWording", "label": "Official approved relationship wording", "type": "paragraph", "requiredWhen": "relationshipType is not no-current-relationship or not-confirmed" },
          { "id": "organisationRelationship.academicWingTermDecision", "label": "May the website call the related organisation the academic wing?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "organisationRelationship.coachingWingTermDecision", "label": "May the website call the related organisation the coaching wing?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "organisationRelationship.partnerTermDecision", "label": "May the website call the related organisation a partner?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "organisationRelationship.integratedTermDecision", "label": "May the website use integrated for this relationship?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "organisationRelationship.otherWordingRestrictions", "label": "Other wording restrictions", "type": "paragraph", "required": false },
          { "id": "organisationRelationship.claimRecordId", "label": "Relationship claim record ID", "type": "short-text", "requiredWhen": "relationshipType is not no-current-relationship or not-confirmed" },
          { "id": "organisationRelationship.evidenceIds", "label": "Relationship evidence IDs", "type": "paragraph-list", "required": true, "validation": "opaque IDs only; a confirmed no-current-relationship restriction still requires its decision evidence" },
          { "id": "organisationRelationship.validFrom", "label": "Relationship decision valid from", "type": "date", "required": true },
          { "id": "organisationRelationship.validUntil", "label": "Relationship decision valid until", "type": "date", "required": true },
          { "id": "organisationRelationship.factState", "label": "Relationship facts confirmed?", "type": "multiple-choice", "required": true, "options": ["confirmed", "not-confirmed"] }
        ]
      },
      {
        "id": "CBSE-SENIOR-SECONDARY",
        "title": "CBSE Senior Secondary",
        "showWhen": "institutionalModel is cbse-senior-secondary-only or both",
        "fields": [
          { "id": "cbseSeniorSecondary.officialName", "label": "Official name", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.officialRecognisedInstitutionName", "label": "Official recognised institution name", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.board", "label": "Board", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.affiliationOrRecognitionNumber", "label": "Affiliation or recognition number", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.institutionCode", "label": "Institution or school code", "type": "short-text", "required": false },
          { "id": "cbseSeniorSecondary.udiseOrOfficialCode", "label": "UDISE or other official code", "type": "short-text", "required": false },
          { "id": "cbseSeniorSecondary.affiliationValidFrom", "label": "Affiliation valid from", "type": "date", "required": true },
          { "id": "cbseSeniorSecondary.affiliationValidUntil", "label": "Affiliation valid until", "type": "date", "required": true },
          { "id": "cbseSeniorSecondary.supportingDocumentState", "label": "Supporting affiliation or approval document", "type": "multiple-choice", "required": true, "options": ["available", "not-available", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.supportingDocumentReference", "label": "Supporting document opaque reference", "type": "short-text", "requiredWhen": "supportingDocumentState is available", "validation": "opaque evidence or guarded document ID only; never a filename, path or URL" },
          { "id": "cbseSeniorSecondary.affiliationOrRecognition", "label": "Affiliation or recognition wording", "type": "paragraph", "required": true },
          { "id": "cbseSeniorSecondary.classes", "label": "Classes", "type": "paragraph-list", "required": true },
          { "id": "cbseSeniorSecondary.providesClassesXiXii", "label": "Does the institution officially provide Classes XI-XII?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.mayUseJuniorCollegeTerm", "label": "May the website use Junior College?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.mayUseSeniorSecondaryTerm", "label": "May the website use Senior Secondary?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.xiXiiEnrolmentOrganisation", "label": "Official institution under which XI-XII students are enrolled", "type": "short-text", "requiredWhen": "providesClassesXiXii is yes", "validation": "organisation name or stable organisation ID; yes/no is invalid" },
          { "id": "cbseSeniorSecondary.streams", "label": "Streams", "type": "paragraph-list", "required": true },
          { "id": "cbseSeniorSecondary.subjects", "label": "Subjects", "type": "paragraph-list", "required": true },
          { "id": "cbseSeniorSecondary.durationSummary", "label": "Programme duration", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.deliveryMode", "label": "General delivery mode", "type": "dropdown", "required": true, "options": ["on-campus", "hybrid", "online", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.eligibility", "label": "Eligibility", "type": "paragraph", "required": true },
          { "id": "cbseSeniorSecondary.feeSummary", "label": "Approved public fee summary", "type": "paragraph", "required": true },
          { "id": "cbseSeniorSecondary.admissionProcedure", "label": "Admission procedure", "type": "paragraph", "required": true },
          { "id": "cbseSeniorSecondary.admissionsWindowState", "label": "Admissions window", "type": "dropdown", "required": true, "options": ["dated", "year-round", "not-confirmed"] },
          { "id": "cbseSeniorSecondary.admissionsOpenOn", "label": "Admissions open on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "cbseSeniorSecondary.admissionsCloseOn", "label": "Admissions close on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "cbseSeniorSecondary.admissionsDecisionBy", "label": "Admissions decision by", "type": "date", "required": false },
          { "id": "cbseSeniorSecondary.batchCount", "label": "Current batch count", "type": "number", "required": true },
          { "id": "cbseSeniorSecondary.intakeCapacity", "label": "Current intake capacity", "type": "number", "required": true },
          { "id": "cbseSeniorSecondary.admissionsCtaLabel", "label": "Approved admissions CTA label", "type": "short-text", "required": true },
          { "id": "cbseSeniorSecondary.admissionsCtaDestination", "label": "Admissions CTA destination", "type": "short-text", "required": true, "validation": "safe internal path or HTTPS URL" },
          { "id": "cbseSeniorSecondary.publicContactRoute", "label": "Public contact route", "type": "short-text", "required": true, "validation": "safe internal route; no personal phone or email" },
          { "id": "cbseSeniorSecondary.publicSummary", "label": "Approved public summary", "type": "paragraph", "required": true },
          { "id": "cbseSeniorSecondary.factState", "label": "CBSE Senior Secondary facts confirmed?", "type": "multiple-choice", "required": true, "options": ["confirmed", "not-confirmed"] }
        ]
      },
      {
        "id": "JUNIOR-COLLEGE",
        "title": "Separate Junior College",
        "showWhen": "institutionalModel is separate-junior-college-only or both",
        "fields": [
          { "id": "juniorCollege.officialName", "label": "Official name", "type": "short-text", "required": true },
          { "id": "juniorCollege.officialRecognisedInstitutionName", "label": "Official recognised institution name", "type": "short-text", "required": true },
          { "id": "juniorCollege.board", "label": "Board", "type": "short-text", "required": true },
          { "id": "juniorCollege.affiliationOrRecognitionNumber", "label": "Affiliation or recognition number", "type": "short-text", "required": true },
          { "id": "juniorCollege.institutionCode", "label": "Institution or college code", "type": "short-text", "required": false },
          { "id": "juniorCollege.udiseOrOfficialCode", "label": "UDISE or other official code", "type": "short-text", "required": false },
          { "id": "juniorCollege.affiliationValidFrom", "label": "Recognition valid from", "type": "date", "required": true },
          { "id": "juniorCollege.affiliationValidUntil", "label": "Recognition valid until", "type": "date", "required": true },
          { "id": "juniorCollege.supportingDocumentState", "label": "Supporting recognition document", "type": "multiple-choice", "required": true, "options": ["available", "not-available", "not-confirmed"] },
          { "id": "juniorCollege.supportingDocumentReference", "label": "Supporting document opaque reference", "type": "short-text", "requiredWhen": "supportingDocumentState is available", "validation": "opaque evidence or guarded document ID only; never a filename, path or URL" },
          { "id": "juniorCollege.affiliationOrRecognition", "label": "Affiliation or recognition wording", "type": "paragraph", "required": true },
          { "id": "juniorCollege.classes", "label": "Classes", "type": "paragraph-list", "required": true },
          { "id": "juniorCollege.providesClassesXiXii", "label": "Does the institution officially provide Classes XI-XII?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "juniorCollege.mayUseJuniorCollegeTerm", "label": "May the website use Junior College?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "juniorCollege.mayUseSeniorSecondaryTerm", "label": "May the website use Senior Secondary?", "type": "multiple-choice", "required": true, "options": ["yes", "no", "not-confirmed"] },
          { "id": "juniorCollege.xiXiiEnrolmentOrganisation", "label": "Official institution under which XI-XII students are enrolled", "type": "short-text", "requiredWhen": "providesClassesXiXii is yes", "validation": "organisation name or stable organisation ID; yes/no is invalid" },
          { "id": "juniorCollege.streams", "label": "Streams", "type": "paragraph-list", "required": true },
          { "id": "juniorCollege.subjects", "label": "Subjects", "type": "paragraph-list", "required": true },
          { "id": "juniorCollege.durationSummary", "label": "Programme duration", "type": "short-text", "required": true },
          { "id": "juniorCollege.deliveryMode", "label": "General delivery mode", "type": "dropdown", "required": true, "options": ["on-campus", "hybrid", "online", "not-confirmed"] },
          { "id": "juniorCollege.eligibility", "label": "Eligibility", "type": "paragraph", "required": true },
          { "id": "juniorCollege.feeSummary", "label": "Approved public fee summary", "type": "paragraph", "required": true },
          { "id": "juniorCollege.admissionProcedure", "label": "Admission procedure", "type": "paragraph", "required": true },
          { "id": "juniorCollege.admissionsWindowState", "label": "Admissions window", "type": "dropdown", "required": true, "options": ["dated", "year-round", "not-confirmed"] },
          { "id": "juniorCollege.admissionsOpenOn", "label": "Admissions open on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "juniorCollege.admissionsCloseOn", "label": "Admissions close on", "type": "date", "requiredWhen": "admissionsWindowState is dated" },
          { "id": "juniorCollege.admissionsDecisionBy", "label": "Admissions decision by", "type": "date", "required": false },
          { "id": "juniorCollege.batchCount", "label": "Current batch count", "type": "number", "required": true },
          { "id": "juniorCollege.intakeCapacity", "label": "Current intake capacity", "type": "number", "required": true },
          { "id": "juniorCollege.admissionsCtaLabel", "label": "Approved admissions CTA label", "type": "short-text", "required": true },
          { "id": "juniorCollege.admissionsCtaDestination", "label": "Admissions CTA destination", "type": "short-text", "required": true, "validation": "safe internal path or HTTPS URL" },
          { "id": "juniorCollege.publicContactRoute", "label": "Public contact route", "type": "short-text", "required": true, "validation": "safe internal route; no personal phone or email" },
