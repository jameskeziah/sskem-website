      {
        "id": "POLICY-VALIDITY",
        "title": "Policy permissions and review ownership",
        "fields": [
          { "id": "governance.publicationPolicyPermission", "label": "Policy permission for public programme information", "type": "multiple-choice", "required": true, "options": ["approved", "not-approved", "not-confirmed"] },
          { "id": "governance.privacyPermission", "label": "Privacy and consent requirements satisfied for the proposed public fields", "type": "multiple-choice", "required": true, "options": ["approved", "not-approved", "not-confirmed"] },
