          { "id": "governance.nextReviewDate", "label": "Next review date", "type": "date", "required": true },
          { "id": "governance.futureUpdateOwnerRole", "label": "Future update owner role", "type": "short-text", "required": true, "validation": "role slug only; never a person's name or email" },
