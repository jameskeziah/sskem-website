        ]
      },
      {
        "id": "APPROVAL",
        "title": "Evidence and management decision",
        "fields": [
          { "id": "approval.controlledEvidenceReferences", "label": "Opaque controlled evidence references", "type": "paragraph-list", "required": true, "validation": "at least two IDs; never URLs, paths, filenames or evidence text" },
          { "id": "approval.approvedByRole", "label": "Approving role", "type": "short-text", "required": true, "validation": "lowercase role slug; never a name or email" },
          { "id": "approval.approvedOn", "label": "Approval date", "type": "date", "required": true },
          { "id": "approval.expiresOn", "label": "Expiry date", "type": "date", "required": false },
          { "id": "approval.confirmation", "label": "Final management confirmation", "type": "checkbox", "required": true, "value": "confirm-management-approved-programmes-content-package" }
        ]
