  "controlledDrive": {
    "rootFolderName": "SSKEMS-Controlled-Publication",
    "defaultAccess": "authorised-school-roles-only",
    "folders": [
      { "order": 0, "path": "00-Governance", "contents": "access register, retention rules and approval workflow" },
      { "order": 1, "path": "01-Programmes/{academicYear}/Affiliation-Recognition", "contents": "current affiliation and recognition records" },
      { "order": 2, "path": "01-Programmes/{academicYear}/Fees", "contents": "approved fee circulars and schedules" },
      { "order": 3, "path": "01-Programmes/{academicYear}/Timetables", "contents": "approved timetable evidence" },
      { "order": 4, "path": "01-Programmes/{academicYear}/Brochures", "contents": "approved programme brochures" },
      { "order": 5, "path": "01-Programmes/{academicYear}/Results", "contents": "aggregate result proofs; no pupil-level exports in the publication workspace" },
      { "order": 6, "path": "01-Programmes/{academicYear}/Faculty", "contents": "approved public bios and consent references; no contact details" },
      { "order": 7, "path": "02-Media/{academicYear}/Photos", "contents": "original approved photographs and rights records" },
      { "order": 8, "path": "02-Media/{academicYear}/Video", "contents": "original approved video and rights records" },
      { "order": 9, "path": "03-Consent/{academicYear}", "contents": "private consent evidence; never copied to the repository, Sheet public tabs or Sanity" },
      { "order": 10, "path": "04-Approvals/{academicYear}", "contents": "management decisions and review receipts" },
      { "order": 11, "path": "05-Publication-Exports/{academicYear}", "contents": "approved public-safe packages and exact publication receipts" }
    ],
    "fileNamingPattern": "{evidenceId}__{documentType}__{YYYY-MM-DD}__v{NN}.{extension}"
  },
  "publicationTracker": {
    "states": ["draft", "in-review", "blocked", "ready-for-implementation", "published", "retired"],
    "requiredGates": [
      "the intake and proposed package use the same reviewed contract version",
      "all required public fields are complete",
      "every critical fact has confirmed rather than not-confirmed state",
      "all cited evidence IDs are verified and current",
      "every exact public claim has a current approved manifest record",
      "management decision is approved and current",
      "publication-policy and privacy permissions are approved",
      "information validity and next-review ownership are current",
      "SEO title and description are reviewed",
      "navigation placement is explicitly approved",
      "public URL is assigned",
      "media and document records pass their independent approval pipelines",
      "the exact public output has a revision or digest receipt before publication"
    ],
    "readyRule": "Ready only when every required gate passes; otherwise Blocked with one explicit blocker.",
    "sanityRule": "A Sanity state is editorial workflow state, not approval evidence and not publication authority."
  },
  "privacy": {
    "allowedInRepository": ["blank field definitions", "public-safe labels", "opaque evidence IDs", "role slugs", "explicitly labelled non-authorizing private-review candidates", "approved public content", "exact public publication receipts"],
    "forbiddenInRepositoryOrSanity": ["pupil or applicant records", "guardian details", "private consent evidence", "approver identities", "staff contact details", "private evidence files", "private Drive links", "source file paths", "passwords or tokens"],
    "completedWorkbookRule": "The populated workbook remains in controlled Drive. Only approved public projections and opaque references may be exported for implementation."
  },
  "guardrails": {
    "googleAssetsProvisioned": false,
    "realProgrammeDataCollected": false,
    "v11ContractActivated": false,
    "unverifiedCandidateUsedAsApproval": false,
    "privateEvidenceIncluded": false,
    "managementApprovalGranted": false,
    "approvalManifestUpdated": false,
    "sanityWritePerformed": false,
    "publicContentPublished": false,
    "navigationActivated": false,
    "deploymentPerformed": false
  }
