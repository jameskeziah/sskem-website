{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/programmes-performance-budget.schema.json",
  "title": "SSKEMS Programme route performance budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "budgetId", "scope", "heroMedia", "pageWeight", "fonts", "animations", "webVitals"],
  "properties": {
    "$schema": { "const": "./programmes-performance-budget.schema.json" },
    "schemaVersion": { "const": 1 },
    "budgetId": { "const": "sskem-programmes-performance-v1" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "privateReviewOnly", "auditMayModifyMedia"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["/school/academics", "/junior-college", "/programmes/jee-neet"] }
        },
        "privateReviewOnly": { "const": true },
        "auditMayModifyMedia": { "const": false }
      }
    },
    "heroMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumImageBytes", "maximumPosterBytes", "maximumVideoBytes", "maximumInitialVideoTransferBytes"],
      "properties": {
        "maximumImageBytes": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "maximumPosterBytes": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "maximumVideoBytes": { "type": "integer", "minimum": 1, "maximum": 3000000 },
        "maximumInitialVideoTransferBytes": { "const": 0 }
      }
    },
    "pageWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumInitialTransferBytes", "maximumRequests"],
      "properties": {
        "maximumInitialTransferBytes": { "type": "integer", "minimum": 1, "maximum": 1500000 },
        "maximumRequests": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumFamilies", "maximumFiles", "maximumTransferBytes", "systemFontsOnly"],
      "properties": {
        "maximumFamilies": { "const": 2 },
        "maximumFiles": { "const": 0 },
        "maximumTransferBytes": { "const": 0 },
        "systemFontsOnly": { "const": true }
      }
    },
    "animations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumMotionComponents", "maximumAutoplayMedia", "maximumInfiniteAnimations", "maximumSingleDurationMs", "reducedMotionRequired"],
      "properties": {
        "maximumMotionComponents": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maximumAutoplayMedia": { "const": 0 },
        "maximumInfiniteAnimations": { "const": 0 },
        "maximumSingleDurationMs": { "type": "integer", "minimum": 0, "maximum": 700 },
        "reducedMotionRequired": { "const": true }
      }
    },
    "webVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumLcpMs", "maximumCls"],
      "properties": {
        "maximumLcpMs": { "type": "integer", "minimum": 1, "maximum": 2500 },
        "maximumCls": { "type": "number", "minimum": 0, "maximum": 0.1 }
      }
    }
  }
}
