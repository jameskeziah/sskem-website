{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/editorial-publication-bindings.schema.json",
  "title": "SSKEMS editorial publication revision bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "registryId", "updatedOn", "policy", "bindings"],
  "properties": {
    "$schema": { "const": "./editorial-publication-bindings.schema.json" },
    "schemaVersion": { "const": 1 },
    "registryId": { "const": "sskem-editorial-publication-bindings" },
    "updatedOn": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateEvidenceStoredInRepository", "exactRevisionRequired", "exactContentDigestRequired", "notes"],
      "properties": {
        "privateEvidenceStoredInRepository": { "const": false },
        "exactRevisionRequired": { "const": true },
        "exactContentDigestRequired": { "const": true },
        "notes": { "type": "string", "minLength": 3 }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bindingId", "approvalRecordIds", "contentType", "documentId", "revision", "contentDigestSha256", "boundOn", "ownerRole", "notes"],
        "properties": {
          "bindingId": { "type": "string", "pattern": "^cms-binding-[a-z0-9-]+$" },
          "approvalRecordIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" }
          },
          "contentType": { "enum": ["siteSettings", "announcement", "admissionCycle", "event"] },
          "documentId": { "type": "string", "pattern": "^(?!drafts\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "contentDigestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "boundOn": { "type": "string", "format": "date" },
          "ownerRole": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "notes": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    }
  }
}
