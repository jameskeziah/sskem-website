{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/legacy-migration-wave.schema.json",
  "title": "SSKEMS legacy migration decision wave",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "waveId",
    "label",
    "matrixId",
    "matrixBuiltOn",
    "prerequisiteWaveIds",
    "recordIds",
    "policy"
  ],
  "properties": {
    "$schema": { "const": "./legacy-migration-wave.schema.json" },
    "schemaVersion": { "const": 1 },
    "waveId": { "type": "string", "pattern": "^legacy-[a-z0-9-]+-wave-[1-9][0-9]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "matrixId": { "const": "sskem-legacy-content-migration" },
    "matrixBuiltOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "prerequisiteWaveIds": {
      "type": "array",
      "description": "Cumulative IDs for every earlier wave, ordered from Wave 1 through the immediately preceding wave.",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^legacy-[a-z0-9-]+-wave-[1-9][0-9]*$" }
    },
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^migration-[a-f0-9]{16}$" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceContentIncluded",
        "decisionsPreselected",
        "repositoryWritePerformed",
        "publicationAuthorized"
      ],
      "properties": {
        "sourceContentIncluded": { "const": false },
        "decisionsPreselected": { "const": false },
        "repositoryWritePerformed": { "const": false },
        "publicationAuthorized": { "const": false }
      }
    }
  }
}
