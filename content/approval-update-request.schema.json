{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/approval-update-request.schema.json",
  "title": "SSKEMS controlled publication approval update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestVersion",
    "recordId",
    "expectedRecordDigest",
    "decision",
    "checks",
    "evidenceReferences",
    "approvedByRole",
    "approvedAt",
    "expiresAt"
  ],
  "properties": {
    "requestVersion": { "const": 1 },
    "recordId": { "type": "string", "pattern": "^(media|claim|document)-[a-z0-9-]+$" },
    "expectedRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "const": "approved" },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "enum": ["verified", "not-applicable"] }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,79}$" }
    },
    "approvedByRole": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date" }
  }
}
