{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/homepage-media-performance-budget.schema.json",
  "title": "SSKEMS homepage media performance budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "budgetId", "policy", "assets"],
  "properties": {
    "$schema": { "const": "./homepage-media-performance-budget.schema.json" },
    "schemaVersion": { "const": 1 },
    "budgetId": { "const": "sskem-homepage-media-performance" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditMayModifyArtwork", "privatePrototypeOverageAllowed", "publicReleaseFailsOnOverage", "exactCampusBindingsRequired", "notes"],
      "properties": {
        "auditMayModifyArtwork": { "const": false },
        "privatePrototypeOverageAllowed": { "const": true },
        "publicReleaseFailsOnOverage": { "const": true },
        "exactCampusBindingsRequired": { "const": 4 },
        "notes": { "type": "string", "minLength": 20 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "publicUrl", "approvalRecordId", "placement", "format", "width", "height", "observedBytes", "maximumBytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^public/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.(?:png|jpeg)$" },
        "publicUrl": { "type": "string", "pattern": "^/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.(?:png|jpeg)$" },
        "approvalRecordId": { "type": "string", "pattern": "^media-[a-z0-9-]+$" },
        "placement": { "enum": ["desktop-hero-and-social", "mobile-hero-private-prototype", "campus-chapter-private-prototype"] },
        "format": { "enum": ["png", "jpeg"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "observedBytes": { "type": "integer", "minimum": 1 },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 500000 }
      }
    }
  }
}
