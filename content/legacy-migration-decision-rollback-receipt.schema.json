{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/legacy-migration-decision-rollback-receipt.schema.json",
  "title": "SSKEMS legacy migration decision rollback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "receiptId", "transactionId", "preparedOn", "state", "decisionBatchId", "worksheetSha256", "matrixSha256Before", "matrixSha256After", "matrixDigestBefore", "matrixDigestAfter", "changedRecordIds", "recordsChanged", "routeDecisionsRecorded", "contentDecisionsRecorded", "rollbackGuard", "guardrails"],
  "properties": {
    "$schema": { "const": "./legacy-migration-decision-rollback-receipt.schema.json" },
    "schemaVersion": { "const": 1 },
    "receiptId": { "const": "sskem-legacy-migration-decision-rollback" },
    "transactionId": { "type": "string", "pattern": "^\\d{14}-[a-f0-9]{12}$" },
    "preparedOn": { "type": "string", "format": "date-time" },
    "state": { "const": "prepared-before-atomic-matrix-write" },
    "decisionBatchId": { "type": "string", "pattern": "^legacy-migration-decisions-[a-f0-9]{24}$" },
    "worksheetSha256": { "$ref": "#/$defs/sha256" },
    "matrixSha256Before": { "$ref": "#/$defs/sha256" },
    "matrixSha256After": { "$ref": "#/$defs/sha256" },
    "matrixDigestBefore": { "$ref": "#/$defs/sha256" },
    "matrixDigestAfter": { "$ref": "#/$defs/sha256" },
    "changedRecordIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 115,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^migration-[a-f0-9]{16}$" }
    },
    "recordsChanged": { "type": "integer", "minimum": 1, "maximum": 115 },
    "routeDecisionsRecorded": { "type": "integer", "minimum": 0, "maximum": 115 },
    "contentDecisionsRecorded": { "type": "integer", "minimum": 0, "maximum": 115 },
    "rollbackGuard": { "type": "string", "minLength": 60, "maxLength": 240 },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorMatrixSnapshotIncluded", "archivedSourceContentIncluded", "privateSourcePathsAdded", "implementationStatusChanged", "approvalGranted", "publicationAuthorized", "cmsWritePerformed", "navigationActivated", "deploymentPerformed"],
      "properties": {
        "priorMatrixSnapshotIncluded": { "const": true },
        "archivedSourceContentIncluded": { "const": false },
        "privateSourcePathsAdded": { "const": false },
        "implementationStatusChanged": { "const": false },
        "approvalGranted": { "const": false },
        "publicationAuthorized": { "const": false },
        "cmsWritePerformed": { "const": false },
        "navigationActivated": { "const": false },
        "deploymentPerformed": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
