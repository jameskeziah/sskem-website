{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sskemschool.com/schemas/homepage-poster-delivery-decision-request.schema.json",
  "title": "Completed SSKEMS homepage poster delivery decision request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestVersion",
    "decisionId",
    "expectedDecisionContractDigest",
    "expectedApprovalRecordDigest",
    "selectedOption",
    "acknowledgements",
    "evidenceReferences",
    "approvedByRole",
    "approvedAt"
  ],
  "properties": {
    "requestVersion": { "const": 1 },
    "decisionId": { "const": "sskem-homepage-poster-delivery" },
    "expectedDecisionContractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expectedApprovalRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectedOption": {
      "enum": [
        "hold-current-png",
        "authorize-lossless-format-review",
        "authorize-controlled-encoding-review",
        "commission-artwork-revision-brief"
      ]
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artworkAndSourceRemainUnchanged",
        "performanceBudgetRemainsFixed",
        "reviewCandidatesRemainPrivate",
        "publicationApprovalRemainsSeparate"
      ],
      "properties": {
        "artworkAndSourceRemainUnchanged": { "const": true },
        "performanceBudgetRemainsFixed": { "const": true },
        "reviewCandidatesRemainPrivate": { "const": true },
        "publicationApprovalRemainsSeparate": { "const": true }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,79}$" }
    },
    "approvedByRole": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
