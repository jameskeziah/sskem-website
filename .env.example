# Optional public homepage brand introduction, separate from the private
# review mode. Enable in the Production environment only after validating
# approved assets, Core Web Vitals, accessibility, and browser tests.
# When true, every homepage load and refresh shows the branded preloader
# for at least 1.5s. Reduced-motion visitors skip the blocking animation.
HOMEPAGE_PUBLIC_PRELOADER=false

# Server-only Sanity Content Lake connection. Leave SANITY_PROJECT_ID empty to
# keep the verified local editorial fallback active.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-08-12

# Server-only, read-only headless WordPress source. Leave empty until the
# private connection audit is intentionally run. Only the current www origin
# and future cms subdomain are accepted.
WORDPRESS_CMS_ORIGIN=

# Experimental GSAP/Zentry-inspired hero. This ONLY renders when
# HOMEPAGE_REVIEW_MODE=private; never activate publicly until individual
# student-media rights, guardian consent, privacy and management approval.
HOMEPAGE_ZENTRY_HERO=off

# ProTrack CRM admissions enquiry bridge: OFF by default.
# First provision a separate SSKEMS tenant and verify that its branch ID belongs
# to that tenant. Deploy both services, privacy-review the form and configure
# edge WAF/rate limits before enabling. No browser-visible CRM credentials.
# Example API origin: https://crm-api.example.org (no /api path)
SSKEMS_CRM_API_ORIGIN=
SSKEMS_CRM_TENANT_SLUG=
SSKEMS_CRM_BRANCH_ID=
SSKEMS_CRM_ENQUIRY_ENABLED=false
