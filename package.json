{
  "name": "sskem-school-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "tokens:build": "node scripts/generate-tokens.mjs",
    "approvals:audit": "node scripts/audit-approval-manifest.mjs",
    "approvals:release": "node scripts/audit-approval-manifest.mjs --release",
    "media:inspect": "node scripts/prepare-campus-media.mjs --inspect",
    "media:prepare": "node scripts/prepare-campus-media.mjs",
    "media:publish": "node scripts/prepare-campus-media.mjs --publish",
    "predev": "npm run tokens:build",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run tokens:build && node scripts/assert-publication-safety.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:review": "cross-env HOMEPAGE_REVIEW_MODE=private npm run build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:contract": "npm run tokens:build && node --experimental-strip-types --test tests/approval-manifest.test.mjs tests/campus-media-pipeline.test.mjs tests/publication-review-contract.test.mjs tests/phase1-contract.test.mjs tests/stage2-disclosure.test.mjs tests/document-compliance.test.mjs tests/stage3-admissions.test.mjs tests/motion-system.test.mjs",
    "test:browser": "cross-env HOMEPAGE_REVIEW_MODE=private npm run test:browser:review",
    "test:browser:review": "npm run build && node scripts/run-browser-tests.mjs",
    "test:visual": "cross-env HOMEPAGE_REVIEW_MODE=private npm run test:visual:review",
    "test:visual:review": "npm run build && node scripts/run-browser-tests.mjs tests/browser/visual.spec.ts",
    "test:visual:update": "cross-env HOMEPAGE_REVIEW_MODE=private npm run test:visual:update:review",
    "test:visual:update:review": "npm run build && node scripts/run-browser-tests.mjs tests/browser/visual.spec.ts --update-snapshots",
    "test": "cross-env HOMEPAGE_REVIEW_MODE=private npm run test:review",
    "test:review": "npm run build && node --experimental-strip-types --test tests/approval-manifest.test.mjs tests/campus-media-pipeline.test.mjs tests/publication-review-contract.test.mjs tests/phase1-contract.test.mjs tests/stage2-disclosure.test.mjs tests/document-compliance.test.mjs tests/stage3-admissions.test.mjs tests/motion-system.test.mjs tests/rendered-html.test.mjs && node scripts/run-browser-tests.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "drizzle-orm": "0.45.2",
    "gsap": "3.15.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
