{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "SSKEMS Phase 1 tokens. Brand colours are provisional until final logo, photography and contrast approval.",
  "reference": {
    "$description": "Raw values that components must not consume directly.",
    "color": {
      "brand": {
        "$type": "color",
        "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9608, 0.9569], "hex": "#fff5f4" } },
        "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.8941, 0.8824], "hex": "#ffe4e1" } },
        "200": { "$value": { "colorSpace": "srgb", "components": [1, 0.7882, 0.7686], "hex": "#ffc9c4" } },
        "300": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.6392, 0.6235], "hex": "#f6a39f" } },
        "400": { "$value": { "colorSpace": "srgb", "components": [0.9098, 0.4667, 0.4627], "hex": "#e87776" } },
        "500": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.3098, 0.3216], "hex": "#c94f52" } },
        "600": { "$value": { "colorSpace": "srgb", "components": [0.6627, 0.2039, 0.2275], "hex": "#a9343a" } },
        "700": { "$value": { "colorSpace": "srgb", "components": [0.5569, 0.1608, 0.1882], "hex": "#8e2930" } },
        "800": { "$value": { "colorSpace": "srgb", "components": [0.4549, 0.1412, 0.1647], "hex": "#74242a" } },
        "900": { "$value": { "colorSpace": "srgb", "components": [0.3804, 0.1216, 0.1412], "hex": "#611f24" } },
        "950": { "$value": { "colorSpace": "srgb", "components": [0.2078, 0.051, 0.0627], "hex": "#350d10" } }
      },
      "neutral": {
        "$type": "color",
        "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
        "50": { "$value": { "colorSpace": "srgb", "components": [0.9804, 0.9765, 0.9686], "hex": "#faf9f7" } },
        "100": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.9412, 0.9255], "hex": "#f2f0ec" } },
        "200": { "$value": { "colorSpace": "srgb", "components": [0.898, 0.8824, 0.8549], "hex": "#e5e1da" } },
        "300": { "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8, 0.7647], "hex": "#d1ccc3" } },
        "400": { "$value": { "colorSpace": "srgb", "components": [0.6667, 0.6392, 0.6039], "hex": "#aaa39a" } },
        "500": { "$value": { "colorSpace": "srgb", "components": [0.4902, 0.4627, 0.4314], "hex": "#7d766e" } },
        "600": { "$value": { "colorSpace": "srgb", "components": [0.3647, 0.3412, 0.3176], "hex": "#5d5751" } },
        "700": { "$value": { "colorSpace": "srgb", "components": [0.2706, 0.2549, 0.2392], "hex": "#45413d" } },
        "800": { "$value": { "colorSpace": "srgb", "components": [0.1725, 0.1647, 0.1569], "hex": "#2c2a28" } },
        "900": { "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1059, 0.098], "hex": "#1c1b19" } },
        "950": { "$value": { "colorSpace": "srgb", "components": [0.0667, 0.0627, 0.0588], "hex": "#11100f" } }
      },
      "green": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.149, 0.4471, 0.3333], "hex": "#267255" } },
      "amber": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.6039, 0.3529, 0.0353], "hex": "#9a5a09" } },
      "red": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7059, 0.1373, 0.1843], "hex": "#b4232f" } },
      "blue": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2471, 0.2784, 0.5529], "hex": "#3f478d" } }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "heading": { "$value": ["Georgia", "Times New Roman", "serif"] },
        "body": { "$value": ["Segoe UI", "Arial", "sans-serif"] }
      },
      "size": {
        "$type": "dimension",
        "100": { "$value": { "value": 0.75, "unit": "rem" } },
        "200": { "$value": { "value": 0.875, "unit": "rem" } },
        "300": { "$value": { "value": 1, "unit": "rem" } },
        "400": { "$value": { "value": 1.125, "unit": "rem" } },
        "500": { "$value": { "value": 1.375, "unit": "rem" } },
        "600": { "$value": { "value": 1.75, "unit": "rem" } },
        "700": { "$value": { "value": 2.25, "unit": "rem" } },
        "800": { "$value": { "value": 3, "unit": "rem" } },
        "900": { "$value": { "value": 4, "unit": "rem" } }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": { "value": 0, "unit": "rem" } },
      "4": { "$value": { "value": 0.25, "unit": "rem" } },
      "8": { "$value": { "value": 0.5, "unit": "rem" } },
      "12": { "$value": { "value": 0.75, "unit": "rem" } },
      "16": { "$value": { "value": 1, "unit": "rem" } },
      "24": { "$value": { "value": 1.5, "unit": "rem" } },
      "32": { "$value": { "value": 2, "unit": "rem" } },
      "48": { "$value": { "value": 3, "unit": "rem" } },
      "64": { "$value": { "value": 4, "unit": "rem" } },
      "96": { "$value": { "value": 6, "unit": "rem" } }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "rem" } },
      "small": { "$value": { "value": 0.375, "unit": "rem" } },
      "medium": { "$value": { "value": 0.75, "unit": "rem" } },
      "large": { "$value": { "value": 1.375, "unit": "rem" } },
      "pill": { "$value": { "value": 999, "unit": "px" } }
    },
    "shadow": {
      "$type": "shadow",
      "small": { "$value": { "color": { "colorSpace": "srgb", "components": [0.0667, 0.0627, 0.0588], "alpha": 0.08, "hex": "#11100f" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
      "medium": { "$value": { "color": { "colorSpace": "srgb", "components": [0.0667, 0.0627, 0.0588], "alpha": 0.12, "hex": "#11100f" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 30, "unit": "px" }, "spread": { "value": -10, "unit": "px" } } },
      "large": { "$value": { "color": { "colorSpace": "srgb", "components": [0.0667, 0.0627, 0.0588], "alpha": 0.16, "hex": "#11100f" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 24, "unit": "px" }, "blur": { "value": 60, "unit": "px" }, "spread": { "value": -18, "unit": "px" } } }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "default": { "$value": { "value": 1, "unit": "px" } },
        "strong": { "$value": { "value": 2, "unit": "px" } }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": { "value": 120, "unit": "ms" } },
        "normal": { "$value": { "value": 220, "unit": "ms" } },
        "slow": { "$value": { "value": 420, "unit": "ms" } }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0, 0, 1] },
        "enter": { "$value": [0.16, 1, 0.3, 1] },
        "exit": { "$value": [0.4, 0, 1, 1] }
      }
    },
    "layout": {
      "$type": "dimension",
      "content": { "$value": { "value": 73.75, "unit": "rem" } },
      "wide": { "$value": { "value": 90, "unit": "rem" } },
      "reading": { "$value": { "value": 45, "unit": "rem" } }
    }
  },
  "semantic": {
    "$description": "Purpose-led aliases consumed by layouts and most components.",
    "surface": {
      "$type": "color",
      "page": { "$value": "{reference.color.neutral.50}" },
      "subtle": { "$value": "{reference.color.neutral.100}" },
      "raised": { "$value": "{reference.color.neutral.0}" },
      "brand": { "$value": "{reference.color.brand.800}" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "{reference.color.neutral.950}" },
      "secondary": { "$value": "{reference.color.neutral.700}" },
      "muted": { "$value": "{reference.color.neutral.600}" },
      "onBrand": { "$value": "{reference.color.neutral.0}" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{reference.color.neutral.300}" },
      "strong": { "$value": "{reference.color.neutral.700}" }
    },
    "action": {
      "$type": "color",
      "primary": { "$value": "{reference.color.brand.700}" },
      "primaryHover": { "$value": "{reference.color.brand.900}" },
      "secondary": { "$value": "{reference.color.blue}" }
    },
    "focus": {
      "$type": "color",
      "ring": { "$value": "{reference.color.blue}" }
    },
    "status": {
      "$type": "color",
      "success": { "$value": "{reference.color.green}" },
      "warning": { "$value": "{reference.color.amber}" },
      "danger": { "$value": "{reference.color.red}" },
      "information": { "$value": "{reference.color.blue}" }
    }
  },
  "component": {
    "$description": "Aliases created only where a component has a durable requirement.",
    "button": {
      "primary": {
        "background": { "$type": "color", "$value": "{semantic.action.primary}" },
        "text": { "$type": "color", "$value": "{semantic.text.onBrand}" }
      }
    },
    "header": {
      "background": { "$type": "color", "$value": "{semantic.surface.raised}" }
    },
    "navigation": {
      "itemHover": { "$type": "color", "$value": "{reference.color.brand.50}" }
    },
    "notice": {
      "background": { "$type": "color", "$value": "{reference.color.brand.900}" }
    },
    "documentCard": {
      "border": { "$type": "color", "$value": "{semantic.border.default}" }
    }
  }
}
